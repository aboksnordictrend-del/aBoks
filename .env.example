# PostgreSQL connection string
# Local:   postgresql://user:password@localhost:5432/aboks
# Neon:    postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
DATABASE_URI=postgresql://user:password@host:5432/dbname

# Generate a strong random string (min 32 chars)
PAYLOAD_SECRET=your-secret-key-minimum-32-characters-long

# OPTIONAL. Signs the promo snapshot carried on the Kustom order (merchant_data) with
# HMAC-SHA256, verified in the webhook before a promo use is registered. Leave unset and the
# snapshot is still validated structurally and cross-checked against the amounts Kustom
# actually charged — signing is defence in depth, not the only protection.
# Must be its own value: never PAYLOAD_SECRET (that signs auth cookies) and never a Kustom
# credential. Minimum 16 characters; ignored below that.
# NOTE: once set, orders created BEFORE it was set carry unsigned data and will be refused
# for usage registration (their money is unaffected). Set it during a quiet period.
# PROMO_MERCHANT_DATA_SECRET=

NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Zoho Mail (EU). Emails are disabled entirely unless all five are set.
SMTP_HOST=smtppro.zoho.eu
SMTP_PORT=465
SMTP_USER=post@aboks.no
SMTP_PASS=your-zoho-app-password
EMAIL_FROM=post@aboks.no
EMAIL_FROM_NAME=aBoks

# Optional email timeouts (ms). The defaults keep a stalled Zoho from ever holding a
# request open long enough to hit Vercel's FUNCTION_INVOCATION_TIMEOUT.
# SMTP_CONNECTION_TIMEOUT_MS=8000
# SMTP_GREETING_TIMEOUT_MS=6000
# SMTP_SOCKET_TIMEOUT_MS=10000
# EMAIL_SEND_TIMEOUT_MS=12000

# Set to 'true' to SMTP-verify the transport once per process (diagnostics only).
# SMTP_VERIFY=false

# --- Meta Marketing API (server-only; never expose to the browser) ---
# Used by the "Synkroniser fra Meta" action to import daily ad spend. The access token and
# app secret are secrets: keep them out of Git and never prefix any of these with
# NEXT_PUBLIC_. Set META_ACCESS_TOKEN / META_APP_SECRET in .env.local and in Vercel env vars.
META_APP_ID=1982122269089471
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_1171305661810272
META_GRAPH_API_VERSION=v24.0

# --- Meta Conversions API (server-only; never expose to the browser) ---
# Used by the Kustom push webhook to report a confirmed Purchase server-side, so a conversion
# is still counted when the browser pixel is blocked or the customer never lands back on the
# confirmation page after paying with Vipps. META_GRAPH_API_VERSION above is shared.
#
# Separate credentials from the Marketing API block: this token is a Conversions API token
# generated on the pixel/dataset in Events Manager, not the ad-account token used for spend.
# META_TEST_EVENT_CODE is for the Test Events tool ONLY — an event sent with it does not count
# as a conversion, so it must never be set in Production.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# META_TEST_EVENT_CODE=

# --- Google Ads API (server-only; never expose to the browser) ---
# Used by the Google Ads card under Markedsføringskanaler to import daily ad spend.
# GOOGLE_ADS_CLIENT_SECRET, GOOGLE_ADS_REFRESH_TOKEN and GOOGLE_ADS_DEVELOPER_TOKEN are
# secrets: keep them out of Git, never prefix any of these with NEXT_PUBLIC_, and set them in
# .env.local and in Vercel env vars only. They are never written to PostgreSQL.
#
#  CLIENT_ID / CLIENT_SECRET  — Google Cloud Console → APIs & Services → Credentials →
#                               OAuth 2.0 Client ID (type "Desktop app" or "Web application").
#  DEVELOPER_TOKEN            — Google Ads (manager account) → Tools → API Center.
#                               A token with *test* access cannot read a production account:
#                               apply for "Basic Access" there before the first sync.
#  REFRESH_TOKEN              — one-time OAuth consent for scope
#                               https://www.googleapis.com/auth/adwords, granted by a Google
#                               user that has access to the ad account. Added manually here.
#  CUSTOMER_ID                — the ad account the costs are read from (10 digits).
#  LOGIN_CUSTOMER_ID          — the manager account (MCC) above it. Optional: leave empty for
#                               a standalone account without a manager.
# Both ids may be written with or without dashes — they are normalized to digits internally.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Optional. Only set these to override the defaults.
#  API_VERSION   — Google Ads API version segment (default v24). Bump it if Google sunsets
#                  the current one; the sync then reports a clear error asking for this.
#  HISTORY_START — floor for the one-off "when does this account's history start?" probe that
#                  a full import runs (default 2015-01-01).
# GOOGLE_ADS_API_VERSION=v24
# GOOGLE_ADS_HISTORY_START=2015-01-01

# --- Pinterest Ads API v5 + OAuth 2.0 (server-only; never expose to the browser) ---
# Used by the Pinterest Ads card under Markedsføringskanaler to import daily ad spend.
# PINTEREST_APP_SECRET and PINTEREST_TOKEN_ENCRYPTION_KEY are secrets: keep them out of Git,
# never prefix any of these with NEXT_PUBLIC_, and set them in .env.local and in Vercel env
# vars only.
#
# Authentication is a real OAuth 2.0 authorization-code flow with continuous refresh, started
# by «Koble til» on the Pinterest Ads card. The tokens are stored AES-256-GCM-encrypted in the
# database, NOT in these variables — there is nothing to paste in by hand and nothing to renew
# manually. Full setup: docs/PINTEREST-OAUTH-SETUP.md
#
#  APP_ID / APP_SECRET  — developers.pinterest.com → your app. Required: they are what the
#                         OAuth flow authenticates with (HTTP Basic on the token endpoint).
#  AD_ACCOUNT_ID        — the ad account the costs are read from (digits only, e.g.
#                         549755885175). Found under Ads → Business Access → Ad accounts.
#                         Required.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_AD_ACCOUNT_ID=

# REQUIRED IN PRODUCTION. A dedicated 32-byte key for encrypting the stored Pinterest tokens.
# Generate with:   openssl rand -base64 32
# Accepts base64, base64url or 64-char hex; the decoded value must be exactly 32 bytes.
#
# When NODE_ENV=production and this is unset, the Pinterest OAuth paths refuse to run with a
# clear error — they do not fall back. The PAYLOAD_SECRET fallback exists for local development
# and tests only: deriving a long-lived credential key from the session secret means rotating
# PAYLOAD_SECRET silently destroys every stored Pinterest token.
#
# NEVER COMMIT THIS VALUE. Rotating it invalidates the stored tokens by design — reconnect after.
# PINTEREST_TOKEN_ENCRYPTION_KEY=

# Optional. Overrides the redirect URI. Resolved automatically otherwise:
#   https://aboks.no/api/pinterest/oauth/callback        (production)
#   http://localhost:3000/api/pinterest/oauth/callback   (local development)
# Set this when the dev server runs on another port (this repo's .env.local uses PORT=3001) or
# to authorize from a Vercel Preview. Whatever you set must ALSO be registered on the Pinterest
# app, byte for byte.
# PINTEREST_REDIRECT_URI=

# Optional. Only set these to override the defaults.
#  API_VERSION   — Pinterest API version segment (default v5).
#  HISTORY_START — floor for a full import (default 2019-01-01). The ad account's own
#                  creation date normally narrows this further; the floor only applies when
#                  Pinterest does not report one.
# PINTEREST_API_VERSION=v5
# PINTEREST_HISTORY_START=2019-01-01

# DEPRECATED — migration fallback only. A manually generated access token, honoured ONLY while
# no OAuth grant is stored, so a deployment mid-migration keeps importing. It cannot be
# refreshed. Delete it from Vercel and from .env.local once «Koble til» has succeeded.
# PINTEREST_ACCESS_TOKEN=

# --- TikTok Marketing API v1.3 (server-only; never expose to the browser) ---
# Used by the TikTok Ads card under Markedsføringskanaler to import daily ad spend.
# Read-only reporting: this integration never creates or edits campaigns, ad groups, ads,
# audiences or budgets. It is NOT the Events API / Pixel — that is separate (see
# gtm/TIKTOK-PIXEL-SETUP.md).
#
# TIKTOK_APP_SECRET is a secret: keep it out of Git, never prefix any of these with
# NEXT_PUBLIC_, and set it in .env.local and in Vercel env vars only.
#
#  APP_ID        — developers.tiktok.com/… → your app. Not a secret; the real value for this
#                  project is below. Required.
#  APP_SECRET    — the same app's secret key. Required.
#  REDIRECT_URI  — must match the redirect URI registered on the TikTok app *byte for byte*.
#                  Point it at this app's callback endpoint. Required.
#  ADVERTISER_ID — the advertiser account costs are read from (digits only). Optional: when
#                  the authorization covers exactly one advertiser it is selected
#                  automatically. Set it when several accounts are authorized.
#  ACCESS_TOKEN  — optional escape hatch for a token issued outside this app. Normally left
#                  empty: "Koble til TikTok" in the admin obtains one and stores it
#                  AES-256-GCM-encrypted in the tiktok-connection global (see
#                  src/lib/tiktok/tokenStore.ts). A Marketing API advertiser token does not
#                  expire — it is valid until the advertiser revokes access.
# See docs/TIKTOK-ADS-SETUP.md for the full walkthrough.
TIKTOK_APP_ID=7668564716072534017
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/admin/integrations/tiktok/callback
TIKTOK_ADVERTISER_ID=
# TIKTOK_ACCESS_TOKEN=
#
#  ADVERTISER_CURRENCY — ISO 4217 code the advertiser account reports in, e.g. NOK.
#    Required in practice when the app is authorized for **Reporting** only: TikTok exposes an
#    advertiser's currency solely through GET /advertiser/info/, which needs the separate
#    **Ad Account Management** permission. Neither oauth2/advertiser/get (id + name) nor
#    report/integrated/get (metrics + dimensions) returns a currency, so with Reporting-only
#    access there is no way to read it from the API.
#    This is a declaration, never a conversion setting: the NOK guard still applies, so
#    declaring anything other than NOK stops the import instead of enabling it. Leave it unset
#    only if the app also has Ad Account Management. Verify the value in TikTok Ads Manager
#    first — the import refuses to run rather than guess.
TIKTOK_ADVERTISER_CURRENCY=NOK

# Optional. Only set these to override the defaults.
#  API_VERSION   — TikTok Marketing API version segment (default v1.3).
#  HISTORY_START — floor for a full import (default 2020-01-01). The advertiser's own
#                  creation date normally narrows this further; the floor only applies when
#                  TikTok does not report one.
# TIKTOK_API_VERSION=v1.3
# TIKTOK_HISTORY_START=2020-01-01

# ── Reviews: Cloudflare Turnstile (optional) ────────────────────────────────────
# The review form is gated behind a secret one-time link, so a visible challenge is not
# required. If you want an extra bot layer, set BOTH keys (from the Cloudflare Turnstile
# dashboard). When unset, the form works without Turnstile; production logs one warning.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=   # public site key (safe to expose)
# TURNSTILE_SECRET_KEY=             # server secret (never expose / never log)
